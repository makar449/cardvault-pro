# CardVault Pro environment variables
# Copy to your hosting provider environment variables or export in terminal.

HOST=0.0.0.0
PORT=8000
APP_URL=https://your-domain.com
CARDVAULT_DB=data/cardvault.sqlite3

# Required in production: generate a long random value.
SECRET_KEY=replace-with-64-random-characters
SESSION_DAYS=30
COOKIE_SECURE=1
DEV_SHOW_TOKENS=0

# Initial admin user, created on first launch.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-this-strong-password

# Payments: manual works immediately; stripe redirects to Stripe Checkout when keys are set.
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=rub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email delivery for verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
